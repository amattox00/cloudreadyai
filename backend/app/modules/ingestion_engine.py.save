from __future__ import annotations

from pathlib import Path
from typing import Any, Dict, List
import csv
import io
import logging

from fastapi import UploadFile
from sqlalchemy.orm import Session
from app.routers.runs import increment_ingest_counts

# v2 ingestion path that actually writes servers into Postgres
from app.modules.ingestion_core.server_ingestion_db_v2 import (
    ingest_servers_v2_from_csv_to_db,
)


def list_ingest_routes() -> List[Dict[str, str]]:
    """
    Lightweight descriptor of ingest routes.

    For the MVP, only servers ingestion is fully wired.
    """
    return [
        {"slice": "servers", "method": "POST", "path": "/v1/ingest/servers"},
    ]


async def ingest_servers(
    db: Session,
    run_id: str,
    file: UploadFile,
) -> Dict[str, Any]:
    """
    MVP servers ingestion:

    - Save uploaded CSV to /tmp
    - Call the v2 ingestion engine to push rows into Postgres
    - Count non-header lines as 'servers_ingested'
    - Return a simple JSON payload that the UI and router can use
    """

    # 1) Persist upload to a temp path
    tmp_path = Path("/tmp/ingest_servers.csv")
    contents = await file.read()
    tmp_path.write_bytes(contents)

    # 2) Count rows (non-empty lines, minus header)
    text = contents.decode("utf-8", errors="ignore")
    lines = [ln for ln in text.splitlines() if ln.strip()]
    servers_ingested = max(len(lines) - 1, 0)

    # 3) Run the tested v2 ingestion engine
    ingest_servers_v2_from_csv_to_db(
        csv_path=tmp_path,
        db=db,
        run_id=run_id or "",
    )

    # 4) Simple, stable response for the frontend/router
    return {
        "slice": "servers",
        "run_id": run_id,
        "status": "ok",
        "servers_ingested": servers_ingested,
        "message": f"Servers CSV ingested successfully ({servers_ingested} rows)",
    }


